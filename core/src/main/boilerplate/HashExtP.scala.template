package laserdisc
package protocol

trait HashExtP { this: HashBaseP =>
  import shapeless.ops.hlist.Tupler

  //HDEL
  [..21#final def hdel(key: Key, [#field1: Key#]): Protocol.Aux[NonNegInt] =
    hdel(key, OneOrMoreKeys.unsafeFrom([#field1# :: ] :: Nil))#
  ]

  //HMGET
  final def hmget[A1](key: Key, field1: Key)(
      implicit ev: Arr ==> (A1 *: EmptyTuple)
  ): Protocol.Aux[A1] =
    hmget[A1 *: EmptyTuple](key, OneOrMoreKeys.unsafeFrom(field1 :: Nil)).map(_.head)
  [2..21#final def hmget[[#A1#]](key: Key, [#field1: Key#])(
      implicit ev##0: Arr ==> ([#A1# *: ] *: EmptyTuple),
      ev##1: Tupler.Aux[[#A1# *: ] *: EmptyTuple, ([#A1#])]
  ): Protocol.Aux[([#A1#])] =
    hmget[[#A1# *: ] *: EmptyTuple](key, OneOrMoreKeys.unsafeFrom([#field1# :: ] :: Nil)).map(_.tupled)#
  ]

  //HMSET
  [..21#final def hmset[[#A1: Show#]](key: Key, [#field1: Key, value1: A1#]): Protocol.Aux[OK] =
    hmset(key, [#(field1, value1)# *: ] *: EmptyTuple)#
  ]
}